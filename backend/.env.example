# AccessAble — Backend Environment Variables
# Copy this file to .env and fill in your values
# In Render: set these in the Environment Variables dashboard

PORT=5000
MONGO_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/accessable
JWT_SECRET=your-very-long-secret-key-here

# Google OAuth Client ID — same value as frontend REACT_APP_GOOGLE_CLIENT_ID
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# Your deployed frontend URL (add to CORS allowed origins)
CLIENT_URL=https://your-app.onrender.com
