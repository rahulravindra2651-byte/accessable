{
  "name": "accessable-fullstack",
  "version": "1.0.0",
  "description": "AccessAble — Real-Time Indian Sign Language & Voice Assistive Platform",
  "main": "backend/server.js",
  "scripts": {
    "install:all": "npm install --legacy-peer-deps && cd backend && npm install",
